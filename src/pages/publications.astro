---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
---

<BaseLayout title="Publications | Roshini Saravanan" description="Scholarly publications and submitted manuscripts by Roshini Saravanan.">
  <header class="page-intro container">
    <p class="eyebrow">Research output</p>
    <h1>Publications</h1>
    <p class="lead">Manuscripts and published research, with the current status shown clearly.</p>
  </header>
  <section class="publication-section">
    <div class="container publication-list">
      <PublicationItem title="Laser Desorption Mass Spectrometry for Mineral Identification" authors="M.C. Raith, R. Saravanan, and R. Arevalo Jr." status="Submitted for review" />
      <p class="publication-note">Journal, DOI, and full citation details will be added after acceptance.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .publication-section { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .publication-list { max-width: 62rem; }
  .publication-note { max-width: 40rem; margin: 1rem 0 0; color: var(--ink-soft); font-size: 0.88rem; }
</style>
