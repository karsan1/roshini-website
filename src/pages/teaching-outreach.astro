---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Teaching & Outreach | Roshini Saravanan" description="University teaching, graduate mentorship, and STEM outreach by Roshini Saravanan.">
  <header class="page-intro container">
    <p class="eyebrow">Teaching, mentorship & engagement</p>
    <h1>Teaching & Outreach</h1>
    <p class="lead placeholder">[Add your own introduction to your teaching, mentorship, and outreach.]</p>
  </header>

  <section class="section teaching-feature">
    <div class="container feature-grid">
      <div>
        <p class="eyebrow">University teaching</p>
        <h2>Earth through Time: Fossils & Rocks</h2>
        <p class="role">Graduate Teaching Assistant · Purdue University · 2026–Present</p>
      </div>
      <div class="feature-copy">
        <p class="lead placeholder">[Add your description of this Graduate Teaching Assistant position.]</p>
      </div>
    </div>
  </section>

  <section class="section mentorship">
    <div class="container section-grid">
      <div><p class="eyebrow">Mentorship</p><h2>Graduate Mentorship Chair</h2></div>
      <div>
        <p class="role">Purdue EAPS Graduate Student Association</p>
        <p class="placeholder">[Add your description of this Graduate Mentorship Chair position.]</p>
      </div>
    </div>
  </section>

  <section class="section outreach">
    <div class="container">
      <div class="section-grid heading-grid">
        <div><p class="eyebrow">STEM outreach</p><h2>Making research approachable</h2></div>
        <p class="lead placeholder">[Add your own introduction to your STEM outreach work.]</p>
      </div>
      <div class="outreach-list">
        <article>
          <span>01</span><div><h3>Outreach Chair</h3><p class="role">GradSWE Purdue</p></div><p class="placeholder">[Add your description of this Outreach Chair position.]</p>
        </article>
        <article>
          <span>02</span><div><h3>EAPS / Physics Graduate Lab Lead</h3><p class="role">Purdue WISP Science Day</p></div><p class="placeholder">[Add your description of this Graduate Lab Lead position.]</p>
        </article>
        <article>
          <span>03</span><div><h3>Stomp Rockets Group Leader</h3><p class="role">Purdue Space Day</p></div><p class="placeholder">[Add your description of this Group Leader position.]</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section earlier-teaching">
    <div class="container section-grid">
      <div><p class="eyebrow">Earlier teaching</p><h2>Undergraduate Teaching Assistant</h2></div>
      <div><p class="role">ENGL101 · University of Maryland · 2022</p><p class="placeholder">[Add your description of this Undergraduate Teaching Assistant position.]</p></div>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-grid, .section-grid { display: grid; gap: var(--space-lg); grid-template-columns: 0.9fr 1.1fr; }
  h2 { max-width: 14ch; }
  .role { color: var(--accent); font-size: 0.86rem; font-weight: 750; }
  .mentorship { background: var(--accent); color: var(--paper); }
  .mentorship .eyebrow, .mentorship .role { color: #b9d7e5; }
  .heading-grid { margin-bottom: var(--space-lg); }
  .outreach-list article { display: grid; padding-block: var(--space-lg); gap: 1.5rem; grid-template-columns: 3rem 0.7fr 1fr; border-top: 1px solid var(--line); }
  .outreach-list article > span { color: var(--accent); font-size: 0.75rem; font-weight: 800; }
  .outreach-list h3 { margin-bottom: 0.5rem; }
  .earlier-teaching { background: var(--paper-deep); }
  @media (max-width: 750px) { .feature-grid, .section-grid { grid-template-columns: 1fr; } .outreach-list article { grid-template-columns: 2rem 1fr; } .outreach-list article > p { grid-column: 2; } }
</style>
