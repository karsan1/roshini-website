---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<header class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {intro && <p class="lead">{intro}</p>}
</header>

<style>
  .section-heading { max-width: 55rem; margin-bottom: var(--space-lg); }
  .section-heading h2 { max-width: 16ch; margin-bottom: 0; }
  .section-heading .lead { margin-top: var(--space-md); }
</style>
