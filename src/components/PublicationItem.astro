---
interface Props {
  title: string;
  authors: string;
  status: string;
  year?: string;
}
const { title, authors, status, year } = Astro.props;
---

<article class="publication-item">
  <div class="publication-meta"><span class="status">{status}</span>{year && <span class="year">{year}</span>}</div>
  <div>
    <h3>{title}</h3>
    <p>{authors}</p>
  </div>
</article>

<style>
  .publication-item { display: grid; padding-block: 1.75rem; gap: 1rem 2rem; grid-template-columns: minmax(8rem, 0.22fr) minmax(0, 0.78fr); border-block: 1px solid var(--line); }
  .publication-meta { padding-top: 0.2rem; }
  .status { color: var(--accent); font-size: 0.82rem; font-weight: 750; }
  .year { margin-left: 0.65rem; color: var(--ink-soft); font-size: 0.82rem; }
  h3 { max-width: 35ch; margin-bottom: 0.45rem; font-size: clamp(1.35rem, 2.3vw, 1.85rem); line-height: 1.2; }
  p { margin-bottom: 0; color: var(--ink-soft); font-size: 0.95rem; }
  @media (max-width: 600px) { .publication-item { grid-template-columns: 1fr; gap: 0.6rem; } }
</style>
