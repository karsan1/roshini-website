---
interface Props {
  title: string;
  authors: string;
  status: string;
  year?: string;
}
const { title, authors, status, year } = Astro.props;
---

<article class="publication-item">
  <div><span class="status">{status}</span>{year && <span class="year">{year}</span>}</div>
  <div>
    <h3>{title}</h3>
    <p>{authors}</p>
  </div>
</article>

<style>
  .publication-item { display: grid; padding-block: 2rem; gap: 1.5rem; grid-template-columns: minmax(10rem, 0.28fr) minmax(0, 0.72fr); border-top: 1px solid var(--line); }
  .status { display: inline-block; padding: 0.25rem 0.45rem; color: var(--accent); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; border: 1px solid var(--accent); }
  .year { margin-left: 0.8rem; color: var(--ink-soft); font-size: 0.85rem; }
  h3 { margin-bottom: 0.5rem; }
  p { margin-bottom: 0; color: var(--ink-soft); }
  @media (max-width: 600px) { .publication-item { grid-template-columns: 1fr; } }
</style>
