---
interface Props { date: string; title: string; organization: string; }
const { date, title, organization } = Astro.props;
---

<li class="timeline-item">
  <span class="date">{date}</span>
  <span><strong>{title}</strong><small>{organization}</small></span>
</li>

<style>
  .timeline-item { display: grid; padding-block: 1rem; gap: 1rem; grid-template-columns: 8.5rem 1fr; border-top: 1px solid var(--line); }
  .date { color: var(--accent); font-size: 0.84rem; font-weight: 750; }
  strong, small { display: block; }
  strong { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; }
  small { margin-top: 0.25rem; color: var(--ink-soft); font-size: 0.84rem; }
  @media (max-width: 480px) { .timeline-item { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
